# Copy to cloud/.env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@localhost:5432/wafer
MQTT_HOST=localhost
MQTT_PORT=1883
# The broker login ingest uses. The separate cloud user was rejected on the Windows broker, so the edge user is used.
MQTT_USER=edge
MQTT_PASS=your-edge-password
TOPIC_PREFIX=mfg598/group3/wafer
QUALITY_ALERT_BELOW=0.6
STOPPED_ALERT_AFTER_S=60
